{
  "annotations": {"list": []},
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "title": "Bankroll (EUR)",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "vbq_bankroll_eur", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "EUR"}, "overrides": []}
    },
    {
      "title": "Current Drawdown %",
      "type": "gauge",
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
      "targets": [{"expr": "vbq_drawdown_pct", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "max": 30, "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 10}, {"color": "red", "value": 20}]}}, "overrides": []}
    },
    {
      "title": "Average CLV %",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "vbq_clv_average", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []}
    },
    {
      "title": "Circuit Breaker Status",
      "type": "stat",
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "vbq_circuit_breaker_active", "refId": "A"}],
      "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "OK", "color": "green"}, "1": {"text": "TRIGGERED", "color": "red"}}}]}, "overrides": []}
    },
    {
      "title": "Bankroll Over Time",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
      "targets": [{"expr": "vbq_bankroll_eur", "legendFormat": "{{mode}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "EUR"}, "overrides": []}
    },
    {
      "title": "Daily ROI by Sport",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
      "targets": [{"expr": "vbq_roi_daily", "legendFormat": "{{sport}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}
    },
    {
      "title": "Execution Latency (P50/P95)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 12},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(vbq_execution_latency_ms_bucket[5m]))", "legendFormat": "P50 {{bookmaker}}", "refId": "A"},
        {"expr": "histogram_quantile(0.95, rate(vbq_execution_latency_ms_bucket[5m]))", "legendFormat": "P95 {{bookmaker}}", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "ms"}, "overrides": []}
    },
    {
      "title": "Bet Rejection Rate",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 12},
      "targets": [
        {"expr": "rate(vbq_bets_rejected_total[1h])", "legendFormat": "{{sport}}/{{bookmaker}}/{{reason}}", "refId": "A"}
      ]
    },
    {
      "title": "Feature Drift PSI",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 20},
      "targets": [{"expr": "vbq_drift_psi", "legendFormat": "{{feature}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.1}, {"color": "red", "value": 0.2}]}}, "overrides": []}
    },
    {
      "title": "Commission Paid (EUR)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 20},
      "targets": [{"expr": "vbq_commission_paid_eur_total", "legendFormat": "{{bookmaker}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "EUR"}, "overrides": []}
    },
    {
      "title": "ROI by Bookmaker",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "targets": [{"expr": "vbq_roi_daily", "legendFormat": "{{bookmaker}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}, "overrides": []},
      "description": "ROI separated by bookmaker — detect systematic slippage or poor execution at a specific house"
    },
    {
      "title": "CLV by Bookmaker",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "targets": [{"expr": "vbq_clv_by_bookmaker", "legendFormat": "{{bookmaker}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "red", "value": null}, {"color": "green", "value": 0.5}]}}, "overrides": []},
      "description": "Closing Line Value per bookmaker — identifies which house offers the best edge"
    },
    {
      "title": "Rejection Rate by Bookmaker",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 36},
      "targets": [{"expr": "rate(vbq_bets_rejected_total[1h])", "legendFormat": "{{bookmaker}}/{{reason}}", "refId": "A"}],
      "description": "Rejection rate per bookmaker — high rejection = possible stake limits or account restrictions"
    },
    {
      "title": "Slippage by Bookmaker",
      "type": "bargauge",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 36},
      "targets": [{"expr": "vbq_slippage_by_bookmaker", "legendFormat": "{{bookmaker}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 3}]}}, "overrides": []},
      "description": "Average slippage (requested odds - executed odds) per bookmaker"
    }
  ],
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["vbq", "betting"],
  "templating": {"list": []},
  "time": {"from": "now-24h", "to": "now"},
