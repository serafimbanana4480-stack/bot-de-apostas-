# Database Configuration
POSTGRES_DB=valuebetting
POSTGRES_USER=vb_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# Redis Cache Configuration
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379
REDIS_HOST=redis

# FastAPI Server Configuration
API_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=your_32_character_hex_secret_key_here
ENCRYPTION_KEY=your_cryptography_fernet_key_here
VBQ_API_KEY=your_internal_api_key_here
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
RATE_LIMIT_ENABLED=true

# API Keys and External Providers
NBA_API_KEY=your_nba_api_key_here
BETFAIR_APP_KEY=your_betfair_app_key_here
BETFAIR_USERNAME=your_betfair_username_here
BETFAIR_PASSWORD=your_betfair_password_here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_channel_or_chat_id_here
ODDS_API_KEY=your_odds_api_key_here
FOOTBALL_DATA_ORG_TOKEN=your_free_token_from_football-data.org
FOOTBALL_API_KEY=optional_api_football_key

# Zero-cost local training (default: no paid APIs)
ZERO_COST_MODE=true
DATA_DIR=data
PAPER_TRADING_ONLY=true
MLFLOW_TRACKING_URI=./mlruns

# Risk Management Parameters
MAX_DAILY_LOSS_PCT=5.0
KELLY_MULTIPLIER=0.25
MAX_DRAWDOWN_PCT=20.0
MAX_LOSS_STREAK=5
MAX_VOLATILITY_THRESHOLD=2.0

# Prefect Orchestration Configuration
PREFECT_API_URL=http://prefect-api:4200/api
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://vb_admin:your_secure_postgres_password_here@postgres:5432/valuebetting

# MLflow MLOps Configuration
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT_NAME=nba_value_betting
