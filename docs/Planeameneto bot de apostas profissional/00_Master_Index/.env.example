# VBQ-UNIFIED Environment Variables Example
# Copy this file to .env and fill in the actual values
# DO NOT commit .env to version control

# ============================================================================
# POSTGRESQL DATABASE
# ============================================================================
POSTGRES_DB=valuebetting
POSTGRES_USER=vb_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# ============================================================================
# REDIS CACHE
# ============================================================================
REDIS_PASSWORD=your_secure_redis_password_here
REDIS_PORT=6379

# ============================================================================
# FASTAPI BACKEND
# ============================================================================
API_PORT=8000
ENVIRONMENT=development

# ============================================================================
# PREFECT (Task Orchestration)
# ============================================================================
PREFECT_UI_PORT=4200

# ============================================================================
# MLFLOW (Experiment Tracking)
# ============================================================================
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
MLFLOW_DEFAULT_ARTIFACT_ROOT=/mlflow/artifacts

# ============================================================================
# GRAFANA (Monitoring)
# ============================================================================
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_secure_grafana_password_here

# ============================================================================
# PROMETHEUS (Metrics)
# ============================================================================
PROMETHEUS_PORT=9090

# ============================================================================
# EXTERNAL APIs - NBA
# ============================================================================
# Get from: https://developer.sportradar.com/
NBA_API_KEY=your_nba_api_key_here
NBA_API_VERSION=v1

# ============================================================================
# EXTERNAL APIs - BETFAIR EXCHANGE
# ============================================================================
# Get from: https://developer.betfair.com/
BETFAIR_API_KEY=your_betfair_api_key_here
BETFAIR_USERNAME=your_betfair_username_here
BETFAIR_PASSWORD=your_betfair_password_here
BETFAIR_APP_KEY=your_betfair_app_key_here

# ============================================================================
# EXTERNAL APIs - THE ODDS API
# ============================================================================
# Get from: https://the-odds-api.com/
THE_ODDS_API_KEY=your_the_odds_api_key_here

# ============================================================================
# TELEGRAM BOT
# ============================================================================
# Get from: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ADMIN_CHAT_ID=your_telegram_admin_chat_id_here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Pipeline execution frequency (hours between batches)
PIPELINE_BATCH_INTERVAL_HOURS=2

# NBA schedule check times (UTC, comma-separated)
NBA_SCHEDULE_TIMES=08:00,10:00,12:00,14:00,16:00

# Value detection thresholds
VALUE_THRESHOLD=0.02
MIN_ODDS=1.5
MAX_ODDS=10.0

# Risk management
KELLY_FRACTION=0.25
MAX_POSITION_SIZE=100
MAX_DAILY_BETS=20
MAX_DAILY_LOSS=500

# Model configuration
MODEL_RETRAIN_INTERVAL_DAYS=7
MODEL_MIN_DATA_POINTS=1000

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================================================
# SECURITY
# ============================================================================
# JWT secret for API authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRATION_HOURS=24

# ============================================================================
# BACKUP CONFIGURATION
# ============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# ============================================================================
# ALERTING
# ============================================================================
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_USERNAME=your_email@gmail.com
ALERT_EMAIL_PASSWORD=your_email_password_here
ALERT_EMAIL_TO=alerts@example.com

ALERT_TELEGRAM_ENABLED=true
ALERT_TELEGRAM_CRITICAL_ONLY=false
